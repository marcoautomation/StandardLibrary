use base.UnitTests as UnitTests;
use base.Block as Block;
use base.Log as Log;
use base.Lists as Lists;
use base.Str as Str;
use base.InMemoryLog as InMemoryLog;

Steps: InMemoryLog[Str]{`steps`}

LoggingExample: UnitTests {
  .tests t-> t.checkWithSys{sys-> Block#
    .do{ Log.log(`starting logging example`) }
    .do{ Steps.log(`step 1`) }
    .do{ Log.log(`processed item 1`) }
    .do{ Steps.log(`step 2`) }
    .do{ Log.log(`processed item 2`) }
    .do{ Steps.log(`step 3`) }
    .do{ Log.log(`processed item 3`) }
    .do{ Log.log(`finished`) }
    .do{ Steps.reader(sys).consume.assertEq({::},Lists#(`step 1`,`step 2`,`step 3`)) }
    .done
    }
  }
